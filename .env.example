# Copy this file to .env for local development. Never commit the real .env file.
APP_ENV=local
APP_DEBUG=true

# Local XAMPP/MariaDB defaults; replace these with the shared host values when available.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=project_lab_db
DB_USER=root
DB_PASSWORD=

# Optional absolute path to the MySQL provider's CA certificate for TLS.
DB_SSL_CA=

# Optional Google OAuth login. Create a Web application OAuth client in Google Cloud,
# add the redirect URI below to its allowlist, then copy values into your private .env.
# Do not commit .env or paste the client secret into chat/GitHub.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Example only: use the exact URL for your local XAMPP project folder.
GOOGLE_REDIRECT_URI=
